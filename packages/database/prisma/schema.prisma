// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id       String    @id @default(cuid())
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?

  personalPage PersonalPage?
}

/// One editable homepage per account: the dashboard intro copy and the drawing pad strokes.
/// Strokes are stored normalized to the pad's 1000x720 view box as one flat [x, y, x, y, ...]
/// array per stroke; see personal-page-validation.ts for the bounds enforced on every write.
model PersonalPage {
  page_id       String   @id @default(cuid())
  user_id       String   @unique
  intro_title   String?
  intro_subhead String?
  intro_body    String?
  strokes       Json     @default("[]")
  updated_at    DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

enum DrawingKind {
  face
  cat
}

model GuestbookEntry {
  entry_id   String      @id @default(cuid())
  seed       String
  kind       DrawingKind
  created_at DateTime    @default(now())

  @@unique([seed, kind])
  @@index([created_at])
}

model TipIdea {
  idea_id      String   @id @default(cuid())
  body         String
  receipt      String   @unique
  status       String   @default("heard")
  shipped_href String?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([status, created_at])
}
