# copy to .env — the real file is gitignored
NODE_ENV=development
ENABLE_GRAPHIQL=true
# comma-separated browser origins are useful when the local Next server moves to port 3001
CORS_ORIGIN=http://localhost:3000

# JWT signing and verification. keep the private key secret; the public key can be shared with
# the verifier but still belongs in the backend environment.
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
ALGORITHM=ES256
EXPIRATION="7d"
AUD=csci32-frontend
ISS=csci32-backend
BCRYPT_ROUNDS=12

# normalized username allowed to read the user directory and read/update the private suggestion inbox.
OWNER_USERNAME=your-username

# DATABASE_URL is not needed here. the generated prisma client loads
# packages/database/.env relative to the schema when @repo/database is imported.
