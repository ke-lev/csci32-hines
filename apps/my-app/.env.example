# the public GraphQL origin used by the browser. include the origin only, not /api/graphql.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# optional Cash App link shown by the tips dialog.
NEXT_PUBLIC_TIPS_URL=

# Optional email notification for new tip submissions. These are server-only: do not prefix
# them with NEXT_PUBLIC_. Verify the sender domain in Resend before using it in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL="site tips <tips@example.com>"
TIP_NOTIFICATION_EMAIL=
SITE_URL=http://localhost:3000

# optional server-side Spotify integration; keep all values out of git.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
